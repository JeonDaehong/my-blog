generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String   @id @default(cuid())
  /// 이 카테고리가 속한 블로그. "tech" = 기술 블로그(/posts), "study" = 공부 블로그(/study)
  blog        String   @default("tech")
  name        String   @unique
  nameEn      String?
  slug        String   @unique
  description   String?
  descriptionEn String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       Post[]

  @@index([blog, order])
}

model Post {
  id          String    @id @default(cuid())
  title       String
  titleEn     String?
  slug        String    @unique
  content     String
  contentEn   String?
  excerpt     String?
  excerptEn   String?
  coverImage  String?
  published   Boolean   @default(false)
  /// 카테고리가 없는 글도 갈라져야 하므로 글 자체에 둔다
  blog        String    @default("tech")
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
  @@index([published, createdAt])
  @@index([blog, published, createdAt])
}

model GuestbookEntry {
  id        String   @id @default(cuid())
  nickname  String
  message   String
  emoji     String   @default("👋")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  viewedAt  DateTime @default(now())

  @@index([path])
  @@index([viewedAt])
}
